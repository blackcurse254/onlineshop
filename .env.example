# GEMINI_API_KEY: Required if Gemini AI features are enabled on server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this storefront is hosted (used for CORS and callbacks).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Required in production (minimum 32 random characters, e.g. `openssl rand -hex 32`).
SESSION_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING_IN_PRODUCTION"

# INITIAL_ADMIN_EMAIL & INITIAL_ADMIN_PASSWORD: Optional bootstrap credentials for first admin account.
# Never commit real passwords. Set via environment secrets in deployment.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Cloud SQL PostgreSQL connection variables (injected automatically in Google AI Studio / Cloud Run):
# SQL_HOST=""
# SQL_DB_NAME=""
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_ADMIN_USER=""
# SQL_ADMIN_PASSWORD=""
