# GEMINI_API_KEY: Required if Gemini AI features are enabled on server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this storefront is hosted (used for CORS/CSRF origin validation and callbacks).
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Optional comma-separated list of additional allowed http/https origins.
ALLOWED_ORIGINS=""

# SESSION_SECRET: Required in production (minimum 32 random characters, e.g. `openssl rand -hex 32`).
SESSION_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING_IN_PRODUCTION"

# ADMIN_EMAILS: Optional comma-separated list of verified admin email addresses.
# INITIAL_ADMIN_EMAIL & INITIAL_ADMIN_PASSWORD: Optional bootstrap credentials for first admin account.
# Never commit real passwords. Set via environment secrets in deployment.
ADMIN_EMAILS=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# EMAIL DELIVERY (Required to activate password reset feature; leave empty to keep reset inactive)
# Option 1: SMTP (via nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Option 2: Resend HTTP API
RESEND_API_KEY=""
# Verified sender address (required for either SMTP or Resend, e.g. "ADONIS <no-reply@yourdomain.ir>")
EMAIL_FROM=""

# Cloud SQL PostgreSQL connection variables (injected automatically in Google AI Studio / Cloud Run):
# SQL_HOST=""
# SQL_DB_NAME=""
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_ADMIN_USER=""
# SQL_ADMIN_PASSWORD=""
